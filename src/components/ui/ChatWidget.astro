---
// No server-side props needed
---

<div x-data="chatWidget()" class="fixed bottom-6 right-6 z-50 font-sans">
  <!-- Chat panel -->
  <div
    x-show="isOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-3 scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 translate-y-3 scale-95"
    class="absolute bottom-16 right-0 w-80 sm:w-96 bg-white rounded-2xl shadow-2xl border border-gray-200 flex flex-col overflow-hidden"
    style="height: 500px; transform-origin: bottom right; min-width: 320px;"
  >
    <!-- Header -->
    <div class="bg-brand-blue text-white px-4 py-3 flex items-center gap-3 shrink-0">
      <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1 1 .03 2.712-1.388 2.443l-1.943-.388a4.535 4.535 0 00-1.832.018l-.8.214m0 0a3.75 3.75 0 11-7.5 0" />
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-semibold leading-tight">Rey Long Assistant</div>
        <div class="text-xs opacity-75 leading-tight">Product &amp; Technical Support</div>
      </div>
      <button
        @click="isOpen = false"
        class="text-white/60 hover:text-white transition-colors shrink-0 p-1"
        aria-label="Close chat"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Messages -->
    <div class="flex-1 overflow-y-auto p-4 space-y-3 bg-gray-50" x-ref="messageList">
      <template x-for="msg in messages" :key="msg.id">
        <div :class="msg.role === 'user' ? 'flex justify-end' : 'flex justify-start'">
          <div
            :class="msg.role === 'user'
              ? 'bg-brand-blue text-white rounded-2xl rounded-br-sm'
              : 'bg-white text-gray-800 border border-gray-200 rounded-2xl rounded-bl-sm shadow-sm'"
            class="px-3 py-2 max-w-[85%] text-sm leading-relaxed whitespace-pre-wrap"
            x-text="msg.content"
          ></div>
        </div>
      </template>

      <!-- Typing indicator (shown while waiting for first token) -->
      <div x-show="isLoading && streamingContent === ''" class="flex justify-start">
        <div class="bg-white border border-gray-200 rounded-2xl rounded-bl-sm px-4 py-3 shadow-sm">
          <div class="flex space-x-1 items-center h-4">
            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0s"></div>
            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.15s"></div>
            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.3s"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Input -->
    <div class="border-t border-gray-200 bg-white p-3 flex gap-2 shrink-0">
      <input
        x-model="inputText"
        @keydown.enter.prevent="sendMessage()"
        :disabled="isLoading"
        type="text"
        placeholder="Ask about our machines..."
        class="flex-1 text-sm border border-gray-300 rounded-xl px-3 py-2 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue disabled:opacity-50 disabled:cursor-not-allowed min-w-0"
      />
      <button
        @click="sendMessage()"
        :disabled="isLoading || !inputText.trim()"
        class="bg-brand-blue text-white rounded-xl px-3 py-2 hover:opacity-90 active:scale-95 transition-all disabled:opacity-40 disabled:cursor-not-allowed shrink-0"
        aria-label="Send message"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Floating button -->
  <button
    @click="toggleChat()"
    :aria-label="isOpen ? 'Close chat' : 'Open product assistant'"
    class="flex items-center gap-2 bg-brand-blue text-white pl-4 pr-5 py-3 rounded-full shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-200"
  >
    <svg
      x-show="!isOpen"
      class="w-7 h-7 shrink-0"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
    </svg>
    <svg
      x-show="isOpen"
      x-cloak
      class="w-7 h-7 shrink-0"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
    <span x-show="!isOpen" class="text-sm font-semibold leading-tight whitespace-nowrap">AI Chatbot</span>
    <span x-show="isOpen" x-cloak class="text-sm font-semibold leading-tight whitespace-nowrap">Close</span>
  </button>
</div>

<script is:inline>
  function chatWidget() {
    return {
      isOpen: false,
      messages: [],
      inputText: '',
      isLoading: false,
      streamingContent: '',
      nextId: 1,
      sessionId: null,

      getSessionId() {
        if (!this.sessionId) {
          let id = localStorage.getItem('rl_chat_session')
          if (!id) {
            id = crypto.randomUUID()
            localStorage.setItem('rl_chat_session', id)
          }
          this.sessionId = id
        }
        return this.sessionId
      },

      toggleChat() {
        this.isOpen = !this.isOpen
        if (this.isOpen && this.messages.length === 0) {
          this.messages.push({
            id: this.nextId++,
            role: 'assistant',
            content: "Hi! I'm Rey Long's product assistant. Ask me about our machines, specifications, or applications — I'm here to help."
          })
        }
        if (this.isOpen) {
          this.$nextTick(() => this.scrollToBottom())
        }
      },

      async sendMessage() {
        const text = this.inputText.trim()
        if (!text || this.isLoading) return

        this.inputText = ''
        this.messages.push({ id: this.nextId++, role: 'user', content: text })
        this.isLoading = true
        this.streamingContent = ''

        const assistantMsg = { id: this.nextId++, role: 'assistant', content: '' }
        this.messages.push(assistantMsg)
        const msgIndex = this.messages.length - 1

        this.$nextTick(() => this.scrollToBottom())

        try {
          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text }),
          })

          if (!res.ok || !res.body) {
            throw new Error('Request failed')
          }

          const reader = res.body.getReader()
          const decoder = new TextDecoder()
          let buffer = ''

          while (true) {
            const { done, value } = await reader.read()
            if (done) break

            buffer += decoder.decode(value, { stream: true })
            const parts = buffer.split('\n')
            buffer = parts.pop() ?? ''

            for (const line of parts) {
              if (!line.startsWith('data: ')) continue
              const data = line.slice(6).trim()
              if (data === '[DONE]') continue
              try {
                const parsed = JSON.parse(data)
                if (parsed.response) {
                  this.messages[msgIndex].content += parsed.response
                  this.streamingContent = this.messages[msgIndex].content
                  this.$nextTick(() => this.scrollToBottom())
                }
              } catch (_) {
                // ignore parse errors on partial chunks
              }
            }
          }

          if (!this.messages[msgIndex].content) {
            this.messages[msgIndex].content = "I couldn't generate a response. Please try again or contact us at t6960638@ms45.hinet.net."
          }

          // Log conversation after stream completes
          fetch('/api/chat-log', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              session_id: this.getSessionId(),
              user_message: text,
              ai_response: this.messages[msgIndex].content,
            }),
          }).catch(() => {})
        } catch (_) {
          this.messages[msgIndex].content = "Something went wrong. Please try again or reach out directly at t6960638@ms45.hinet.net."
        } finally {
          this.isLoading = false
          this.streamingContent = ''
          this.$nextTick(() => this.scrollToBottom())
        }
      },

      scrollToBottom() {
        const el = this.$refs.messageList
        if (el) el.scrollTop = el.scrollHeight
      },
    }
  }
</script>
