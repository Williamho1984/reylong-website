---
interface Slide {
  title: string
  subtitle: string
  ctaText: string
  ctaHref: string
  bgClass: string
  image?: string
  imageAlt?: string
  // 'light' = product shot on a white/bright background -> dark text + white scrim.
  // default (dark) = full-bleed photo -> white text + dark scrim.
  theme?: 'light' | 'dark'
}

interface Props {
  slides: Slide[]
}

const { slides } = Astro.props
---

<section
  aria-label="Featured highlights"
  x-data={`{ current: 0, total: ${slides.length} }`}
  x-init="setInterval(function () { current = (current + 1) % total }, 5000)"
  class="relative overflow-hidden bg-gray-900"
>
  <div class="relative h-[70vh] md:h-[85vh] min-h-[460px]">
    {slides.map((slide, i) => {
      // Only the first slide is the page's H1; the rest are H2 to keep a single H1 per page (SEO).
      const Heading = i === 0 ? 'h1' : 'h2'
      const light = slide.theme === 'light'
      return (
      <div
        x-show={`current === ${i}`}
        x-transition:enter="transition-opacity duration-700"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition-opacity duration-300"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        :aria-hidden={`current !== ${i}`}
        class:list={['absolute inset-0 flex items-center', slide.image ? (light ? 'bg-white' : '') : slide.bgClass]}
        {...(i > 0 ? { 'x-cloak': '' } : {})}
      >
        {slide.image && (
          <>
            <img
              src={slide.image}
              alt={slide.imageAlt ?? slide.title}
              class="absolute inset-0 w-full h-full object-cover brightness-110"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
            {light ? (
              /* White-bg product shot: strong black gradient over the left half so white text reads; right stays bright for the product. */
              <div class="absolute inset-0 bg-gradient-to-r from-black/80 from-10% via-black/55 via-45% to-transparent to-60%" />
            ) : (
              /* Light dark scrim + text drop-shadow keeps white copy legible while imagery stays bright. */
              <>
                <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/15 to-transparent" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent" />
              </>
            )}
          </>
        )}
        <div class="container-wide text-white relative z-10">
          <Heading class="text-5xl md:text-7xl font-extrabold tracking-tight max-w-3xl leading-[1.05] drop-shadow-lg">{slide.title}</Heading>
          <p class="text-lg md:text-2xl mt-6 text-white/90 max-w-xl leading-relaxed drop-shadow">{slide.subtitle}</p>
          <a href={slide.ctaHref} class="btn-primary mt-10 inline-block text-lg shadow-xl">{slide.ctaText}</a>
        </div>
      </div>
      )
    })}
  </div>

  <!-- Dot controls -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2" role="tablist" aria-label="Carousel slides">
    {slides.map((slide, i) => (
      <button
        role="tab"
        :aria-selected={`current === ${i}`}
        :aria-label="`${slide.title} slide`"
        @click={`current = ${i}`}
        class="h-2 rounded-full transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        :class={`current === ${i} ? 'w-6 bg-white' : 'w-2 bg-white/40'`}
      />
    ))}
  </div>
</section>
