---
import type { ProductMedia } from '../../lib/db/products'

interface Props {
  media: ProductMedia[]
  productName: string
}

const { media, productName } = Astro.props
const images = media.filter(m => m.type === 'image')
const videos = media.filter(m => m.type === 'video')
const pdfs = media.filter(m => m.type === 'catalog_pdf')

function getEmbedUrl(url: string): string {
  if (url.includes('youtube.com/watch')) {
    return url.replace('watch?v=', 'embed/')
  }
  if (url.includes('youtu.be/')) {
    const id = url.split('youtu.be/')[1]?.split('?')[0]
    return `https://www.youtube.com/embed/${id}`
  }
  if (url.includes('vimeo.com/')) {
    const id = url.split('vimeo.com/')[1]?.split('?')[0]
    return `https://player.vimeo.com/video/${id}`
  }
  return url
}
---

<div x-data="{ activeImage: 0 }">
  <!-- Main image display -->
  <div class="aspect-[4/3] bg-gray-100 overflow-hidden mb-3">
    {images.length > 0 ? (
      images.map((img, i) => (
        <img
          src={img.url}
          alt={img.caption_en || productName}
          x-show={`activeImage === ${i}`}
          class="w-full h-full object-cover"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))
    ) : (
      <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm" aria-hidden="true">
        No images available
      </div>
    )}
  </div>

  <!-- Thumbnails -->
  {images.length > 1 && (
    <div class="flex gap-2 overflow-x-auto pb-2" role="list" aria-label="Product image thumbnails">
      {images.map((img, i) => (
        <button
          role="listitem"
          @click={`activeImage = ${i}`}
          :aria-pressed={`activeImage === ${i}`}
          :aria-label="`View image ${i + 1}: ${img.caption_en || productName}`"
          class="flex-shrink-0 w-16 h-16 overflow-hidden border-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          :class={`activeImage === ${i} ? 'border-brand-blue' : 'border-gray-200'`}
        >
          <img src={img.url} alt="" class="w-full h-full object-cover" />
        </button>
      ))}
    </div>
  )}

  <!-- Videos -->
  {videos.length > 0 && (
    <div class="mt-6">
      <h3 class="font-semibold mb-3 text-lg">Product Videos</h3>
      <div class="space-y-4">
        {videos.map(video => (
          <div class="aspect-video">
            <iframe
              src={getEmbedUrl(video.url)}
              class="w-full h-full"
              allowfullscreen
              loading="lazy"
              title={video.caption_en || `${productName} video`}
            />
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- PDF Downloads -->
  {pdfs.length > 0 && (
    <div class="mt-6">
      <h3 class="font-semibold mb-3 text-lg">Product Catalog</h3>
      <ul class="space-y-2">
        {pdfs.map(pdf => (
          <li>
            <a
              href={pdf.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-brand-blue hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
            >
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
              </svg>
              {pdf.caption_en || 'Download Catalog (PDF)'}
              <span class="sr-only">(opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
