---
const currentPath = Astro.url.pathname
const isEs = currentPath.startsWith('/es')
const prefix = isEs ? '/es' : ''

const navLinks = isEs
  ? [
      { href: `${prefix}/products`, label: 'Productos' },
      { href: '/case-studies', label: 'Casos de Éxito' },
      { href: '/es/news', label: 'Noticias' },
      { href: '/events', label: 'Eventos' },
      { href: '/about/', label: 'Nosotros' },
      { href: '/contact/', label: 'Contacto' },
    ]
  : [
      { href: '/products', label: 'Products' },
      { href: '/case-studies', label: 'Case Studies' },
      { href: '/faq/', label: 'FAQ' },
      { href: '/news', label: 'News' },
      { href: '/events', label: 'Events' },
      { href: '/about/', label: 'About' },
      { href: '/contact/', label: 'Contact' },
    ]

const ctaLabel = isEs ? 'Cotizar' : 'Get a Quote'
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="container-wide">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <span class="text-2xl font-bold">
          <span class="text-brand-red">Rey</span><span class="text-brand-blue">long</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav aria-label="Main navigation" class="hidden lg:flex items-center gap-6">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-brand-blue',
              currentPath.startsWith(link.href)
                ? 'text-brand-blue border-b-2 border-brand-blue pb-1'
                : 'text-gray-700'
            ]}
          >
            {link.label}
          </a>
        ))}
        <a href="/contact/" class="btn-primary text-sm px-4 py-2">{ctaLabel}</a>
      </nav>

      <!-- Mobile menu button -->
      <button
        x-data="{ open: false }"
        @click="open = !open; $dispatch('toggle-menu')"
        :aria-expanded="open.toString()"
        aria-controls="mobile-menu"
        class="lg:hidden p-2 text-gray-700"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div
    id="mobile-menu"
    x-data="{ open: false }"
    @toggle-menu.window="open = !open"
    x-show="open"
    x-cloak
    x-transition
    class="lg:hidden bg-white border-t border-gray-100"
  >
    <nav aria-label="Mobile navigation" class="container-wide py-4 flex flex-col gap-2">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="py-2 text-gray-700 font-medium hover:text-brand-blue"
        >
          {link.label}
        </a>
      ))}
      <a href="/contact/" class="btn-primary text-center mt-2">{ctaLabel}</a>
    </nav>
  </div>
</header>
