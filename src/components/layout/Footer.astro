---
const year = new Date().getFullYear()
const isEs = Astro.url.pathname.startsWith('/es')

const t = isEs
  ? {
      tagline: 'Fabricante profesional de maquinaria plástica y de embalaje.<br />Atendemos clientes en todo el mundo.',
      productsHeading: 'Productos',
      allProducts: 'Todos los Productos',
      bagMaking: 'Máquinas para Fabricar Bolsas',
      recycling: 'Equipos de Reciclaje',
      companyHeading: 'Empresa',
      about: 'Nosotros',
      caseStudies: 'Casos de Éxito',
      events: 'Eventos',
      contact: 'Contacto',
      copyright: `© ${year} Reylong Machinery Co., Ltd. Todos los derechos reservados.`,
    }
  : {
      tagline: 'Professional manufacturer of plastic and packaging machinery.<br />Serving clients worldwide.',
      productsHeading: 'Products',
      allProducts: 'All Products',
      bagMaking: 'Bag Making Machines',
      recycling: 'Recycling Equipment',
      companyHeading: 'Company',
      about: 'About Us',
      caseStudies: 'Case Studies',
      events: 'Events',
      contact: 'Contact',
      copyright: `© ${year} Reylong Machinery Co., Ltd. All rights reserved.`,
    }

const productsHref = isEs ? '/es/products' : '/products'
const eventsHref = isEs ? '/es/events' : '/events'
---

<footer class="bg-gray-900 text-gray-300 mt-20">
  <div class="container-wide py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <div class="text-2xl font-bold mb-3">
          <span class="text-brand-red">Rey</span><span class="text-brand-blue-light">long</span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed" set:html={t.tagline} />
      </div>

      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">{t.productsHeading}</h3>
        <ul class="space-y-1 text-sm">
          <li><a href={productsHref} class="hover:text-white transition-colors">{t.allProducts}</a></li>
          <li><a href={`${productsHref}#bag-making-machines`} class="hover:text-white transition-colors">{t.bagMaking}</a></li>
          <li><a href={`${productsHref}#recycling-machines`} class="hover:text-white transition-colors">{t.recycling}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">{t.companyHeading}</h3>
        <ul class="space-y-1 text-sm">
          <li><a href="/about/" class="hover:text-white transition-colors">{t.about}</a></li>
          <li><a href="/case-studies" class="hover:text-white transition-colors">{t.caseStudies}</a></li>
          <li><a href={eventsHref} class="hover:text-white transition-colors">{t.events}</a></li>
          <li><a href="/contact/" class="hover:text-white transition-colors">{t.contact}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-8 pt-6 text-sm text-gray-500 flex flex-col md:flex-row justify-between gap-2">
      <span>{t.copyright}</span>
      <span>reylong.com</span>
    </div>
  </div>
</footer>
