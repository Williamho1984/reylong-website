---
import '../styles/global.css'
import SEOHead from '../components/seo/SEOHead.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import ChatWidget from '../components/ui/ChatWidget.astro'

interface Props {
  title: string
  description: string
  ogImage?: string
  lang?: 'en' | 'es'
}

const { title, description, ogImage, lang = 'en' } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead title={title} description={description} ogImage={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Reylong Machinery Co., Ltd.",
      "alternateName": ["REY LONG MACHINERY INDUSTRIAL CO., LTD.", "瑞隆機械工業股份有限公司"],
      "url": "https://www.reylong.com",
      "logo": "https://www.reylong.com/favicon.svg",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+886-5-5511888",
        "contactType": "sales",
        "availableLanguage": ["English", "Chinese"]
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "No. 3 Chu-Wei Road, Shi-Chou Li",
        "addressLocality": "Dou-Liu City",
        "addressRegion": "Yunlin County",
        "addressCountry": "TW"
      },
      "email": "t6960638@ms45.hinet.net",
      "telephone": "+886-5-5511888",
      "foundingLocation": "Taiwan",
      "knowsAbout": ["plastic machinery", "woven bag machines", "flexographic printing machines", "packaging machinery"]
    })} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:text-brand-blue focus:px-4 focus:py-2 focus:font-semibold"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ChatWidget />
  </body>
</html>
