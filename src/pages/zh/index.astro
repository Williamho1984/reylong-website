---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductCard from '../../components/ui/ProductCard.astro'
import { getFeaturedProducts } from '../../lib/db/products'

const featuredProducts = await getFeaturedProducts().catch(() => [])
---

<BaseLayout
  title="瑞隆機械 — 塑膠與包裝機械製造商"
  description="瑞隆機械工業股份有限公司，專業製造製袋生產線、渦電流回收分選設備及 AI 智慧機械解決方案，服務全球 30 餘國客戶。"
  lang="zh"
>
  <!-- Hero -->
  <section class="bg-gradient-to-r from-gray-900 to-brand-blue/80 text-white py-24">
    <div class="container-wide">
      <h1 class="text-4xl md:text-5xl font-bold text-white leading-tight">
        塑膠與包裝<br />機械製造商
      </h1>
      <p class="mt-4 text-blue-100 text-lg max-w-2xl">
        製袋生產線、回收分選設備、AI 智慧解決方案——專為工業量產設計，服務全球 30 餘國客戶。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/products" class="bg-white text-brand-blue px-6 py-3 font-semibold hover:bg-gray-100 transition-colors">
          查看產品
        </a>
        <a href="/contact/" class="border border-white text-white px-6 py-3 font-semibold hover:bg-white/10 transition-colors">
          聯絡我們
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-16 container-wide">
    <div class="flex justify-between items-end mb-8">
      <div>
        <h2>主要產品</h2>
        <p class="text-gray-500 mt-1">工業級機械設備，品質可靠</p>
      </div>
      <a href="/products" class="btn-secondary text-sm">查看全部 →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProducts.map(product => (
        <ProductCard product={product} lang="en" />
      ))}
      {featuredProducts.length === 0 && (
        <p class="text-gray-500 col-span-3 text-center py-8">產品資料載入中。</p>
      )}
    </div>
  </section>

  <!-- Company Intro -->
  <section class="bg-gray-50 py-16">
    <div class="container-wide grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2>為何選擇瑞隆？</h2>
        <p class="text-gray-600 mt-4 leading-relaxed">
          瑞隆機械工業股份有限公司擁有逾二十年的製造經驗，專業生產塑膠及包裝機械，
          設備持續運行於亞洲、拉丁美洲、中東及非洲各地工廠。
          我們提供客製化方案與完整的售後技術支援。
        </p>
        <ul class="mt-6 space-y-2 text-gray-700">
          <li class="flex items-center gap-2"><span class="text-brand-orange font-bold">✓</span> 超過 20 年製造經驗</li>
          <li class="flex items-center gap-2"><span class="text-brand-orange font-bold">✓</span> 服務全球 30 餘國客戶</li>
          <li class="flex items-center gap-2"><span class="text-brand-orange font-bold">✓</span> 完整售後技術支援</li>
          <li class="flex items-center gap-2"><span class="text-brand-orange font-bold">✓</span> 可依需求客製化</li>
        </ul>
        <a href="/about/" class="btn-primary mt-8 inline-block">了解瑞隆</a>
      </div>
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 p-6">
          <div class="text-3xl font-bold text-brand-blue">20+</div>
          <div class="text-gray-600 mt-1">年製造經驗</div>
        </div>
        <div class="bg-white border border-gray-200 p-6">
          <div class="text-3xl font-bold text-brand-blue">30+</div>
          <div class="text-gray-600 mt-1">服務國家</div>
        </div>
        <div class="bg-white border border-gray-200 p-6">
          <div class="text-3xl font-bold text-brand-blue">AI</div>
          <div class="text-gray-600 mt-1">智慧製造解決方案</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-blue py-16 text-center text-white">
    <div class="container-wide">
      <h2 class="text-white">準備好升級您的生產線了嗎？</h2>
      <p class="mt-3 text-blue-200 text-lg">立即聯絡我們的業務團隊，取得專屬報價。</p>
      <a
        href="/contact/"
        class="mt-8 inline-block bg-white text-brand-blue px-8 py-4 font-bold hover:bg-gray-100 transition-colors"
      >
        立即詢價
      </a>
    </div>
  </section>
</BaseLayout>
