---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroCarousel from '../components/ui/HeroCarousel.astro'
import ProductCard from '../components/ui/ProductCard.astro'
import NewsCard from '../components/ui/NewsCard.astro'
import CaseStudyCard from '../components/ui/CaseStudyCard.astro'
import EventCard from '../components/ui/EventCard.astro'
import { getFeaturedProducts } from '../lib/db/products'
import { getLatestNews } from '../lib/db/news'
import { getLatestCaseStudies } from '../lib/db/case-studies'
import { getUpcomingEvents } from '../lib/db/events'

const [featuredProducts, latestNews, latestCases, upcomingEvents] = await Promise.all([
  getFeaturedProducts().catch(() => []),
  getLatestNews(3).catch(() => []),
  getLatestCaseStudies(3).catch(() => []),
  getUpcomingEvents().catch(() => [])
])

const heroSlides = [
  {
    title: 'Plastic & Packaging Machinery',
    subtitle: 'Woven bag lines, recycling systems, and flexible packaging solutions — engineered for industrial production.',
    ctaText: 'View Products',
    ctaHref: '/products',
    bgClass: 'bg-gradient-to-r from-gray-900 to-brand-blue/80'
  },
  {
    title: 'Global Manufacturing Partner',
    subtitle: 'Trusted by plastic processing manufacturers in 30+ countries. Built to last.',
    ctaText: 'Our Case Studies',
    ctaHref: '/case-studies',
    bgClass: 'bg-gradient-to-r from-brand-red/90 to-gray-900'
  }
]
---

<BaseLayout
  title="Reylong — Plastic & Packaging Machinery Manufacturer"
  description="Reylong manufactures industrial plastic and packaging machinery — woven bag lines, eddy current separators, pouch making machines, and more. Serving clients in 30+ countries."
>
  <!-- Hero -->
  <HeroCarousel slides={heroSlides} />

  <!-- Featured Products -->
  <section class="pt-24 pb-16 container-wide" aria-label="Featured products">
    <div class="flex justify-between items-end mb-8">
      <div>
        <h2>Our Machines</h2>
        <p class="text-gray-500 mt-1">Industrial-grade equipment for serious manufacturers</p>
      </div>
      <a href="/products" class="btn-secondary text-sm">View All →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProducts.map(product => (
        <ProductCard product={product} lang="en" />
      ))}
      {featuredProducts.length === 0 && (
        <p class="text-gray-500 col-span-3 text-center py-8">Products coming soon.</p>
      )}
    </div>
  </section>

  <!-- Company Intro -->
  <section class="bg-gray-50 pt-16 pb-24" aria-label="Why choose Reylong">
    <div class="container-wide grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2>Why Reylong?</h2>
        <p class="text-gray-600 mt-4 leading-relaxed">
          With over two decades of experience, Reylong delivers robust plastic and packaging
          machinery engineered for continuous, high-volume production. Our machines operate in
          factories across Asia, Latin America, the Middle East, and Africa.
        </p>
        <ul class="mt-6 space-y-2 text-gray-700" role="list">
          <li class="flex items-center gap-2"><span class="text-brand-orange font-bold" aria-hidden="true">✓</span> 20+ years manufacturing experience</li>
          <li class="flex items-center gap-2"><span class="text-brand-orange font-bold" aria-hidden="true">✓</span> Clients in 30+ countries</li>
          <li class="flex items-center gap-2"><span class="text-brand-orange font-bold" aria-hidden="true">✓</span> Full after-sales technical support</li>
          <li class="flex items-center gap-2"><span class="text-brand-orange font-bold" aria-hidden="true">✓</span> Customization available</li>
        </ul>
        <a href="/about" class="btn-primary mt-8 inline-block">Learn About Us</a>
      </div>
      <div class="bg-gray-200 aspect-video flex items-center justify-center text-gray-500 text-sm">
        Factory Image Placeholder
      </div>
    </div>
  </section>

  <!-- News + Case Studies + Events -->
  <section class="py-16 container-wide" aria-label="Latest news and events">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- News -->
      <div>
        <div class="flex justify-between items-end mb-6">
          <h2 class="text-xl font-bold">News</h2>
          <a href="/news" class="text-brand-blue text-sm hover:underline">All →</a>
        </div>
        <div class="space-y-1">
          {latestNews.map(article => <NewsCard article={article} lang="en" />)}
          {latestNews.length === 0 && <p class="text-gray-500 text-sm">No news yet.</p>}
        </div>
      </div>

      <!-- Case Studies -->
      <div>
        <div class="flex justify-between items-end mb-6">
          <h2 class="text-xl font-bold">Case Studies</h2>
          <a href="/case-studies" class="text-brand-blue text-sm hover:underline">All →</a>
        </div>
        <div class="space-y-3 min-h-[100px]">
          {latestCases.map(cs => <CaseStudyCard caseStudy={cs} lang="en" />)}
          {latestCases.length === 0 && <p class="text-gray-500 text-sm">No case studies yet.</p>}
        </div>
      </div>

      <!-- Events -->
      <div>
        <div class="flex justify-between items-end mb-6">
          <h2 class="text-xl font-bold">Upcoming Events</h2>
          <a href="/events" class="text-brand-blue text-sm hover:underline">All →</a>
        </div>
        <div class="min-h-[100px]">
          {upcomingEvents.slice(0, 3).map(event => <EventCard event={event} lang="en" />)}
          {upcomingEvents.length === 0 && <p class="text-gray-500 text-sm">No upcoming events.</p>}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-brand-blue py-16 text-center text-white">
    <div class="container-wide">
      <h2 class="text-white">Ready to upgrade your production line?</h2>
      <p class="mt-3 text-blue-200 text-lg">Get a personalized quote from our team.</p>
      <a href="/contact" class="mt-8 inline-block bg-white text-brand-blue px-8 py-4 font-bold hover:bg-gray-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2">
        Request a Quote
      </a>
    </div>
  </section>
</BaseLayout>
