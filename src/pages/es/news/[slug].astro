---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getNewsBySlug } from '../../../lib/db/news'
import { metaDescription } from '../../../lib/meta'
import { sanitizeArticleHtml } from '../../../lib/sanitize'
import { faqPageSchema } from '../../../lib/schema'

const { slug } = Astro.params
if (!slug) return Astro.redirect('/es/news')
const article = await getNewsBySlug(slug)
if (!article) return Astro.redirect('/es/news')

const body = sanitizeArticleHtml(article.content_es)

const date = new Date(article.published_at).toLocaleDateString('es-ES', {
  year: 'numeric', month: 'long', day: 'numeric'
})
const description = metaDescription(article.content_es) || article.title_es

const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : `https://www.reylong.com${Astro.url.pathname}`

const newsArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.title_es,
  description,
  inLanguage: 'es',
  datePublished: article.published_at,
  dateModified: article.published_at,
  url: pageUrl,
  ...(article.cover_image_url ? { image: article.cover_image_url } : {}),
  author: {
    '@type': 'Organization',
    name: 'Reylong Machinery Co., Ltd.',
    url: 'https://www.reylong.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Reylong Machinery Co., Ltd.',
    url: 'https://www.reylong.com',
  },
}

const faqSchema = faqPageSchema(article.faq, 'es')

function safeJson(obj: unknown): string {
  return JSON.stringify(obj)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/\//g, '\\u002f')
}
---

<BaseLayout title={`${article.title_es} — Reylong`} description={description} lang="es">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJson(newsArticleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={safeJson(faqSchema)} />}
  </Fragment>
  <article class="container-wide py-12 max-w-3xl">
    <nav aria-label="Breadcrumb" class="text-sm text-gray-500 mb-6">
      <a href="/es" class="hover:text-brand-blue">Inicio</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <a href="/es/news" class="hover:text-brand-blue">Noticias</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span class="text-gray-800">{article.title_es}</span>
    </nav>

    <time datetime={article.published_at} class="text-sm text-gray-500 uppercase tracking-wide">{date}</time>
    <h1 class="mt-2">{article.title_es}</h1>

    {article.cover_image_url && (
      <img
        src={article.cover_image_url}
        alt={article.title_es}
        class="w-full aspect-video object-cover mt-6"
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}

    <div class="prose prose-gray max-w-none mt-8" set:html={body} />
  </article>
</BaseLayout>
