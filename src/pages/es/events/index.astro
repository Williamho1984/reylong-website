---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import EventCard from '../../../components/ui/EventCard.astro'
import { getAllEvents } from '../../../lib/db/events'

const events = await getAllEvents().catch((err) => { console.error('Failed to fetch events:', err); return [] })
const today = new Date().toISOString().split('T')[0]
const upcoming = events.filter(e => e.date_end >= today)
const past = events.filter(e => e.date_end < today)
---

<BaseLayout
  title="Ferias y Exposiciones — Reylong Machinery"
  description="Encuentre a Reylong en ferias internacionales de embalaje y plásticos: vea en directo nuestras líneas de sacos tejidos de PP, bolsas y equipos de reciclaje."
  lang="es"
>
  <div class="container-wide py-12">
    <h1>Ferias y Exposiciones</h1>
    <p class="text-gray-600 mt-2">Nos encontrará en ferias internacionales de todo el mundo.</p>

    {upcoming.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold border-b pb-2 mb-4">Próximas</h2>
        <div class="max-w-xl">
          {upcoming.map(event => <EventCard event={event} lang="es" />)}
        </div>
      </section>
    )}

    {past.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold border-b pb-2 mb-4 text-gray-500">Ferias Anteriores</h2>
        <div class="max-w-xl opacity-60">
          {past.map(event => <EventCard event={event} lang="es" />)}
        </div>
      </section>
    )}

    {events.length === 0 && <p class="text-gray-500 mt-8">No hay ferias programadas.</p>}
  </div>
</BaseLayout>
