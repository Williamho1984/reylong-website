---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getNewsBySlug } from '../../lib/db/news'
import { metaDescription } from '../../lib/meta'
import { sanitizeArticleHtml } from '../../lib/sanitize'
import { faqPageSchema } from '../../lib/schema'

const { slug } = Astro.params
if (!slug) return Astro.redirect('/news')
const article = await getNewsBySlug(slug)
if (!article) return Astro.redirect('/news')

const body = sanitizeArticleHtml(article.content_en)

const date = new Date(article.published_at).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
})
// Show "Updated" only when the edit happened on a later day than publication.
const updatedDate = article.updated_at && article.updated_at.slice(0, 10) > article.published_at.slice(0, 10)
  ? new Date(article.updated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null
const description = metaDescription(article.content_en) || article.title_en

const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : `https://www.reylong.com${Astro.url.pathname}`
const esPageUrl = Astro.site
  ? new URL('/es' + Astro.url.pathname, Astro.site).toString()
  : `https://www.reylong.com/es${Astro.url.pathname}`

const newsArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.title_en,
  description,
  datePublished: article.published_at,
  dateModified: article.updated_at ?? article.published_at,
  url: pageUrl,
  ...(article.cover_image_url ? { image: article.cover_image_url } : {}),
  author: {
    '@type': 'Organization',
    name: 'Reylong Machinery Co., Ltd.',
    url: 'https://www.reylong.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Reylong Machinery Co., Ltd.',
    url: 'https://www.reylong.com',
  },
}

const faqSchema = faqPageSchema(article.faq, 'en')

function safeJson(obj: unknown): string {
  return JSON.stringify(obj)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/\//g, '\\u002f')
}
---

<BaseLayout title={`${article.title_en} — Reylong`} description={description} alternateHref={esPageUrl}>
  <Fragment slot="head">
    <meta name="author" content="Reylong Engineering Team" />
    <meta property="article:published_time" content={article.published_at} />
    <meta property="article:modified_time" content={article.updated_at ?? article.published_at} />
    <script type="application/ld+json" set:html={safeJson(newsArticleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={safeJson(faqSchema)} />}
  </Fragment>
  <article class="container-wide py-12 max-w-3xl">
    <nav aria-label="Breadcrumb" class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-brand-blue">Home</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <a href="/news" class="hover:text-brand-blue">News</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span class="text-gray-800">{article.title_en}</span>
    </nav>

    <p class="text-sm text-gray-500 uppercase tracking-wide">
      <time datetime={article.published_at}>{date}</time>
      {updatedDate && (
        <Fragment> · Updated <time datetime={article.updated_at}>{updatedDate}</time></Fragment>
      )}
    </p>
    <h1 class="mt-2">{article.title_en}</h1>
    <p class="mt-2 text-sm text-gray-500">By the Reylong Engineering Team</p>

    {article.cover_image_url && (
      <img
        src={article.cover_image_url}
        alt={article.title_en}
        class="w-full aspect-video object-cover mt-6"
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}

    <div class="prose prose-gray max-w-none mt-8" set:html={body} />
  </article>
</BaseLayout>
