---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ImageGallery from '../../components/ui/ImageGallery.astro'
import SpecsTable from '../../components/ui/SpecsTable.astro'
import ApplicationsGrid from '../../components/ui/ApplicationsGrid.astro'
import AiSolutionStory from '../../components/ui/AiSolutionStory.astro'
import ProductSchema from '../../components/seo/ProductSchema.astro'
import InquiryForm from '../../components/ui/InquiryForm.astro'
import TechArticleSection from '../../components/ui/TechArticleSection.astro'
import { getProductBySlug, getProductMedia } from '../../lib/db/products'
import { metaDescription } from '../../lib/meta'

const { slug } = Astro.params
if (!slug) return Astro.redirect('/products')
const product = await getProductBySlug(slug)
if (!product) return Astro.redirect('/products')

const media = await getProductMedia(product.id).catch(() => [])
const mainImageUrl = media.find(m => m.type === 'image')?.url

// Solution-type products use an article/story layout (alternating image + text)
// instead of the gallery + specs-table template. Driven by the products.content JSONB.
const aiContent = product.content?.sections?.length ? product.content : null
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : `https://reylong.com${Astro.url.pathname}`
const esPageUrl = Astro.site
  ? new URL('/es' + Astro.url.pathname, Astro.site).toString()
  : `https://reylong.com/es${Astro.url.pathname}`

type FAQItem = { q: string; a: string }

const productFAQ: Record<string, FAQItem[]> = {
  'automatic-printing-tubing-cutting-sewing-line': [
    { q: 'What is the production speed of the JLPTCSM-1300W conversion line?', a: 'The JLPTCSM-1300W produces 25–40 bags/min in a fully integrated process combining flexographic printing, tube forming, cutting & sewing, and overtape application in one continuous line.' },
    { q: 'What bag dimensions can the JLPTCSM-1300W produce?', a: 'Fabric width before tubing: 700–1300 mm. Finished bag width: 430–660 mm. Cutting length: 550–1250 mm. Gusset depth is adjustable from 40–90 mm.' },
    { q: 'How many print colors does the conversion line support?', a: '4-color flexographic printing (4+0 configuration) with a printing repeat length of 450–1200 mm and max printing width of 1300 mm.' },
    { q: 'What fabric types does the JLPTCSM-1300W handle?', a: 'The line processes both plain and laminated PP woven fabric. BOPP laminated fabric is supported for applications requiring moisture resistance or a glossy print surface.' },
    { q: 'Is a "conversion line" the same as a woven bag cutting and stitching machine?', a: 'Yes. "Cutting and stitching machine", "cutting and sewing machine", and "woven sack conversion line" are regional terms for the same equipment class. The JLPTCSM-1300W covers all of these functions — it cuts tubular PP woven fabric to length and stitches the bottom hem — and adds flexographic printing and overtape application in the same continuous pass.' },
    { q: 'What is the standard lead time and delivery process?', a: 'Standard lead time is 2–3 months from order confirmation, covering manufacturing, quality testing, and pre-shipment inspection. Rey Long assists with export documentation and container loading.' },
  ],
  'hp-l-2tzp600-stand-up-zipper-pouch-machine': [
    { q: 'What bag styles can the JL-L-2TZP600 produce?', a: 'Five formats on one platform: three-side seal, three-side seal with zipper, four-side seal, doypack, and doypack with zipper. Switching formats requires a changeover but no separate machine.' },
    { q: 'What is the maximum production speed?', a: 'Up to 220 pcs/min for three-side seal bags, 150 pcs/min for three-side seal zipper bags, and 120 pcs/min for doypack pouches. Minimum speed is 35 pcs/min across all formats.' },
    { q: 'What laminated films can the machine process?', a: 'Heat-seal laminated films 30–180 μm thick. Common structures include NY/PE, PET/PE, AL/PE, OPP/CPP, and BOPP/LLDPE. Temperature range up to 300°C supports retort-grade films.' },
    { q: 'How accurate is the sealing and print registration?', a: 'Positional accuracy is ≤0.3 mm via full Panasonic servo control. The sealing system uses 4 groups of heating + 2 groups of cooling for consistent seal quality at high speed.' },
    { q: 'Is installation and operator training included?', a: 'Yes. Rey Long provides on-site installation, technical documentation, and operator training during commissioning. Remote support via video call is available after installation.' },
  ],
  'flexographic-printing-machine-6c': [
    { q: 'What materials can the JLRPM-6800BO/6C print on?', a: 'PP woven fabric and PP laminated fabric with a max web width of 800 mm and max machine speed of 120 m/min (printing speed up to 100 m/min).' },
    { q: 'How many colors and what configurations are supported?', a: '6 colors via 6 independent printing stations with ceramic anilox rollers. Configurations: 0+6, 1+5, 2+4, 3+3 (front/back). An inter-color drying system ensures clean color separation.' },
    { q: 'What causes common print defects and how are they fixed?', a: 'Most defects stem from pressure, ink chemistry (pH/viscosity), or mechanical concentricity. Dot gain is fixed by reducing impression pressure to "kiss print" level. Gear marks require checking T.I.R. of rotating parts. Dirty print requires cleaning the anilox roller and cylinders.' },
    { q: 'What is the recommended maintenance schedule?', a: 'Daily: clean anilox with vendor-specified solvents or hot water (water-based inks) immediately after the run. Before each job: inspect gear condition, test ink viscosity and pH, check plate mounting for trapped air.' },
    { q: 'What is the standard lead time?', a: 'Standard lead time is 2–3 months from order confirmation. Rey Long provides full technical documentation and commissioning support.' },
  ],
  'eddy-current-non-ferrous-separator': [
    { q: 'What materials does the JLECS-1000W recover?', a: 'Non-ferrous metals including aluminum, copper, and brass from mixed streams such as e-waste, shredded plastic, and mixed scrap. It combines magnetic drum separation (ferrous removal) with eddy current separation (non-ferrous recovery).' },
    { q: 'What is the processing capacity?', a: 'The JLECS-1000W operates at 1,000 kg/h. Contact us with your input material composition and particle size for a detailed performance assessment.' },
    { q: 'What industries use the eddy current separator?', a: 'Common applications include e-waste recycling, municipal solid waste sorting, aluminum recovery from shredded scrap, and plastic recycling lines that require metal removal.' },
    { q: 'Is installation and training provided?', a: 'Yes. Rey Long provides on-site installation, technical documentation, and operator training. Remote technical support is also available after commissioning.' },
    { q: 'What is the standard lead time?', a: 'Standard lead time is 2–3 months from order confirmation, covering manufacturing, quality testing, and pre-shipment inspection.' },
  ],
  'ai-machine-intelligence-solutions': [
    { q: 'What does AI-Powered Machine Intelligence actually do on a plastic bag making machine?', a: 'It adds a "digital brain" to the line through three capabilities: it digitizes veteran operators\' parameter know-how and recommends optimal settings on the HMI, runs CNN computer-vision inspection to catch defects in real time, and applies dynamic error compensation that corrects the servo drives to tighten cutting and sewing accuracy. All inference runs on edge hardware at the machine.' },
    { q: 'Can it be retrofitted onto machines we already operate?', a: 'Yes. The program is engineered case by case for a specific machine and process and integrates into existing production lines through standard industrial protocols (OPC-UA, Modbus, MQTT) — no full machine replacement required. Send us your machine type and target application for an assessment.' },
    { q: 'Does the system need internet or cloud connectivity?', a: 'No. All AI inference and decision-making run locally on edge hardware installed at the machine, with near-zero latency and full offline resilience. This suits factory environments with limited networks or strict data-security requirements.' },
    { q: 'What defects can the computer-vision inspection detect?', a: 'Printing defects (registration drift, ink skip, blur, smearing), material defects (broken warp/weft filaments, weave holes, surface fuzz), and processing defects (skipped stitches, cut-point offset, uneven hems). The model deploys few-shot — a baseline can be built from as few as ~50 reference samples — and targets up to 95%+ defect recall.' },
    { q: 'How much can it improve accuracy and reduce waste?', a: 'By reading Eye-Mark deformation and compensating the servo drives in real time, cutting and sewing accuracy can target ≤ ±1 mm versus the ~±5 mm typical of fixed-length cutting, with scrap reduced to as low as ~2% from ~5% and print yield up by around 5% — all application-dependent. One operator can also supervise up to 4 machines instead of 2.' },
    { q: 'Does it help when running recycled (PCR) material?', a: 'Yes. Recycled resin has unstable melt flow and tensile strength that can cause breaks at high speed. The AI tension-control loop senses the resulting micro-variations and automatically adjusts speed and sealing temperature to keep the bag within its strength spec — increasingly useful as brands move to higher recycled content.' },
  ],
}

const faqItems: FAQItem[] = productFAQ[slug] ?? [
  { q: `What materials can the ${product.name_en} process?`, a: 'The machine is designed for processing polypropylene (PP), polyethylene (PE), and other polymer materials common in plastic and packaging applications. Please contact us for your specific material requirements.' },
  { q: 'What after-sales support does Reylong provide?', a: 'Rey Long provides full technical documentation, remote support via video call, and on-site installation assistance. Spare parts are available globally with fast delivery.' },
  { q: 'Can machines be customized for specific production requirements?', a: 'Yes. Rey Long offers customization for most machine models — including speed, bag size range, optional accessories, and special material compatibility. Contact our engineering team with your requirements.' },
]
---

<BaseLayout
  title={`${product.name_en} — Reylong`}
  description={metaDescription(product.description_en)}
  ogImage={mainImageUrl}
  alternateHref={esPageUrl}
>
  <Fragment slot="head">
    <ProductSchema product={product} imageUrl={mainImageUrl} pageUrl={pageUrl} faq={faqItems} />
  </Fragment>

  <div class="container-wide py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-sm text-gray-500 mb-6">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-brand-blue">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/products" class="hover:text-brand-blue">Products</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="text-gray-800">{product.name_en}</li>
      </ol>
    </nav>

    {aiContent ? (
      <!-- Solution intro (article layout) -->
      <div class="max-w-3xl">
        <p class="text-sm text-gray-500 uppercase tracking-wide mb-1 capitalize">
          {product.category.replace(/-/g, ' ')}
        </p>
        <h1>{product.name_en}</h1>
        <p class="text-gray-600 mt-4 leading-relaxed">{product.description_en}</p>
        <div class="flex flex-wrap gap-3 mt-6">
          <a href="#inquiry" class="btn-primary">Request a Quote</a>
          <a href="/contact/" class="btn-secondary">Contact Us</a>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Media Gallery -->
        <div>
          <ImageGallery media={media} productName={product.name_en} />
        </div>

        <!-- Product Info -->
        <div>
          <p class="text-sm text-gray-500 uppercase tracking-wide mb-1 capitalize">
            {product.category.replace(/-/g, ' ')}
          </p>
          <h1>{product.name_en}</h1>
          <p class="text-gray-600 mt-4 leading-relaxed">{product.description_en}</p>

          <div class="flex flex-wrap gap-3 mt-6">
            <a href="#inquiry" class="btn-primary">Request a Quote</a>
            <a href="/contact/" class="btn-secondary">Contact Us</a>
          </div>
        </div>
      </div>
    )}

    {aiContent ? (
      <!-- Solution story: hero, results, alternating sections, machines -->
      <AiSolutionStory content={aiContent} lang="en" />
    ) : (
      <Fragment>
        <!-- Application Fields -->
        <ApplicationsGrid applications={product.applications ?? []} lang="en" />

        <!-- Technical Specs -->
        {(Array.isArray(product.specs) ? product.specs.length : Object.keys(product.specs ?? {}).length) > 0 && (
          <section class="mt-12" aria-label="Technical specifications">
            <h2 class="mb-4">Technical Specifications</h2>
            <SpecsTable specs={product.specs} />
          </section>
        )}
      </Fragment>
    )}

    {!aiContent && product.tech_article?.sections?.length ? (
      <TechArticleSection article={product.tech_article} lang="en" />
    ) : null}

    <!-- FAQ Section (AEO) -->
    <section class="mt-12" aria-label="Frequently asked questions">
      <h2 class="mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqItems.map(item => (
          <details class="border border-gray-200 p-4 group">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-3">
              <h3 class="text-base md:text-lg font-semibold">{item.q}</h3>
              <span class="text-gray-400 group-open:rotate-180 transition-transform shrink-0" aria-hidden="true">▼</span>
            </summary>
            <p class="mt-3 text-gray-600">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Inquiry Form -->
    <section id="inquiry" class="mt-12 bg-gray-50 p-8" aria-label="Request a quote">
      <h2 class="mb-2">Request a Quote for {product.name_en}</h2>
      <p class="text-gray-600 mb-6">Fill in the form below and our team will respond within 1 business day.</p>
      <InquiryForm productId={product.id} productName={product.name_en} />
    </section>
  </div>
</BaseLayout>
