---
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import InquiryForm from '../components/ui/InquiryForm.astro'
---

<BaseLayout
  title="Contact Us — Reylong"
  description="Contact Reylong Machinery for product inquiries, pricing, technical support, spare parts or a factory visit. Our export team replies within one business day."
>
  <div class="container-wide py-12">
    <div class="max-w-3xl">
      <h1>Get in Touch</h1>
      <p class="text-gray-600 mt-2 text-lg">
        Ready to discuss your production needs? Fill in the form and we'll get back to you promptly.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mt-10">
      <div class="lg:col-span-2">
        <InquiryForm />
      </div>

      <aside aria-label="Contact information">
        <div class="space-y-6">
          <div>
            <h2 class="text-base font-semibold">Contact Person</h2>
            <p class="text-gray-700 text-sm mt-1">William HO</p>
          </div>
          <div>
            <h2 class="text-base font-semibold">Email</h2>
            <a href="mailto:t6960638@ms45.hinet.net" class="text-brand-blue text-sm hover:underline">t6960638@ms45.hinet.net</a>
          </div>
          <div>
            <h2 class="text-base font-semibold">Mobile</h2>
            <a href="tel:+886921794380" class="text-brand-blue text-sm hover:underline">+886 921 794 380</a>
          </div>
          <div>
            <h2 class="text-base font-semibold">Office Hours</h2>
            <p class="text-gray-600 text-sm mt-1">Monday–Friday, 09:00–18:00 CST</p>
          </div>
          <div>
            <h2 class="text-base font-semibold">Follow Us</h2>
            <div class="flex gap-4 mt-2">
              <a href="#" aria-label="Facebook" class="hover:opacity-80 transition-opacity">
                <svg class="w-9 h-9" fill="#1877F2" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
              </a>
              <a href="#" aria-label="Instagram" class="hover:opacity-80 transition-opacity">
                <svg class="w-9 h-9" fill="#E1306C" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
              <a href="#" aria-label="X (Twitter)" class="hover:opacity-80 transition-opacity">
                <svg class="w-9 h-9" fill="#000000" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
